const fs = require('fs');
const path = require('path');

/**
 * Scansiona src/events/ e registra ogni file come listener sul client.
 * Ogni file deve esportare { name: string, once?: boolean, execute: fn }.
 */
function loadEvents(client) {
  const eventsPath = path.join(__dirname, '..', 'events');
  const eventFiles = fs.readdirSync(eventsPath).filter((f) => f.endsWith('.js'));

  for (const file of eventFiles) {
    const event = require(path.join(eventsPath, file));
    if (!event?.name || !event?.execute) {
      console.warn(`[Ranji] Evento ${file} non valido: manca "name" o "execute".`);
      continue;
    }

    if (event.once) {
      client.once(event.name, (...args) => event.execute(...args, client));
    } else {
      client.on(event.name, (...args) => event.execute(...args, client));
    }
  }

  console.log(`[Ranji] Caricati ${eventFiles.length} eventi.`);
}

module.exports = { loadEvents };
