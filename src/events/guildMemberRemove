const { logToGuild } = require('../utils/logger');

module.exports = {
  name: 'guildMemberRemove',
  async execute(member) {
    await logToGuild(member.guild, {
      title: '📤 Membro uscito',
      color: 0x95a5a6,
      fields: [
        { name: 'Utente', value: `${member.user.tag} (${member.id})`, inline: true },
        { name: 'Membri totali', value: `${member.guild.memberCount}`, inline: true },
      ],
    });
  },
};
